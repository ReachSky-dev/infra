# Generowany przez Ansible — nie edytuj ręcznie na serwerze.
# Źródło: roles/apps/frontend/templates/docker-compose.yml.j2
#
# Środowisko: {{ env_name }}
# Obraz:      {{ frontend_image_repo }}@{{ frontend_digest }}
# Sieć {{ internal_network_name }} tworzona przez rolę infra — external: true.

services:

  frontend:
    image: ${FRONTEND_IMAGE}
    container_name: "reachsky-{{ env_name }}-frontend"
    restart: unless-stopped
    environment:
      API_URL:        {{ url_api }}{{ api_path_prefix }}
      OIDC_AUTHORITY: {{ url_auth }}/realms/reachsky
      OIDC_CLIENT_ID: ${OIDC_CLIENT_ID}
    networks:
      - internal
    deploy:
      resources:
        limits:
          memory: {{ mem_frontend }}

networks:
  internal:
    name: "{{ internal_network_name }}"
    external: true   # tworzona przez rolę infra
